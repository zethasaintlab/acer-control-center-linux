[Unit]
Description=Acer Control Center Privileged Hardware Control Daemon
Documentation=https://github.com/zethasaintlab/acer-control-center-linux
After=dbus.service polkit.service

[Service]
Type=dbus
BusName=io.github.zethasaintlab.AcerControlCenter1
ExecStart=/usr/libexec/acer-control-daemon
Restart=on-failure
RestartSec=3

# Security & Least-Privilege Sandboxing
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ReadWritePaths=-/sys/devices/system/cpu/intel_pstate/no_turbo -/sys/devices/system/cpu/intel_pstate/min_perf_pct -/sys/devices/system/cpu/intel_pstate/max_perf_pct -/sys/devices/system/cpu/cpufreq
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
ProtectProc=invisible
ProcSubset=pid
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @reboot @swap @obsolete @cpu-emulation @debug @raw-io @module @clock
UMask=0077

[Install]
WantedBy=multi-user.target
Alias=dbus-io.github.zethasaintlab.AcerControlCenter1.service
